generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String?
  isAdmin             Boolean  @default(false)
  trialUsageCount     Int      @default(1)
  isSubscribed        Boolean  @default(false)
  subscriptionId      String?
  subscriptionStartDate DateTime?
  subscriptionEndDate DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  planHistory         PlanHistory[]
  activityLogs        ActivityLog[]

  @@index([subscriptionId])
}

model PlanHistory {
  id               String   @id @default(cuid())
  userId           String
  planName         String
  billingCycle     String
  status           String
  subscriptionId   String
  provider         String   @default("RAZORPAY")
  providerSubscriptionId String?
  currency         String   @default("INR")
  amountMinor      Int?
  billingCountry   String?
  paymentMethodType String?
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([subscriptionId])
  @@index([providerSubscriptionId])
}

model GuestUsage {
  id            String   @id @default(cuid())
  cookieId      String   @unique
  remainingUses Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  targetType  String?
  targetId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([userId])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminPlan {
  id          String   @id
  name        String
  description String?
  billingCycle String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  features    Json?
  prices      Json     @default("{}")
  provider    String   @default("RAZORPAY")
  providerPlanId String?
  countryScope String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}
